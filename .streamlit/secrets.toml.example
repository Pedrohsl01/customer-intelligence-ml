# Copie para .streamlit/secrets.toml (que NÃO vai para o Git) e preencha.
# Supabase → Project Settings → API

[supabase]
url = "https://SEU-PROJETO.supabase.co"
# Chave pública ("anon" / "publishable"). Nunca coloque a service_role aqui:
# ela ignora o Row Level Security.
anon_key = "SUA_CHAVE_ANON"

# Chave da Groq (console.groq.com) usada para gerar as personas. É do servidor:
# as empresas clientes não precisam ter uma.
[groq]
api_key = "gsk_SUA_CHAVE"

# Resend (resend.com), para o botão "Enviar teste para meu e-mail". Opcional.
# Sem domínio verificado, mantenha o remetente de teste: ele só entrega no e-mail da sua conta Resend.
[resend]
api_key = "re_SUA_CHAVE"
remetente = "Customer Intelligence <onboarding@resend.dev>"
